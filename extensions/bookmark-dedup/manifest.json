{
  "manifest_version": 3,
  "name": "Bookmark Dedup",
  "version": "1.0.0",
  "description": "Smart bookmark cleaner — finds duplicates, broken links, and empty folders.",
  "permissions": ["bookmarks", "storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bookmark Dedup"
  },
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  }
}
