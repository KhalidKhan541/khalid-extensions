{
  "manifest_version": 3,
  "name": "Dark Mode Plus",
  "version": "1.0.0",
  "description": "Custom dark mode for any website with advanced controls, scheduling, and per-site settings.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dark-engine.js", "content.js"],
      "css": ["inject.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dark-engine.js", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "context_menus": [
    {
      "id": "dark-mode-plus-toggle",
      "title": "Toggle Dark Mode",
      "contexts": ["page"]
    },
    {
      "id": "dark-mode-plus-add-whitelist",
      "title": "Add to Whitelist (Keep Light)",
      "contexts": ["page"]
    },
    {
      "id": "dark-mode-plus-remove-whitelist",
      "title": "Remove from Whitelist",
      "contexts": ["page"]
    }
  ]
}
