{
  "manifest_version": 3,
  "name": "FeedPulse",
  "version": "1.0.0",
  "description": "RSS/Atom feed reader with notifications. Subscribe to your favorite feeds and stay updated.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [],
  "web_accessible_resources": [
    {
      "resources": ["article.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
