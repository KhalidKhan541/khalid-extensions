{
  "manifest_version": 3,
  "name": "QR Forge",
  "version": "1.0.0",
  "description": "Generate QR codes and barcodes from URLs and text",
  "permissions": ["activeTab", "storage", "tabs", "contextMenus"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"] }],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "web_accessible_resources": [{ "resources": ["qr-generator.js", "barcode-generator.js"], "matches": ["<all_urls>"] }]
}
