{
  "manifest_version": 3,
  "name": "Quick Launcher",
  "version": "1.0.0",
  "description": "Power-user omnibox launcher with fuzzy search, commands, and quick tools.",
  "permissions": [
    "storage",
    "tabs",
    "bookmarks",
    "history",
    "omnibox",
    "topSites",
    "sessions",
    "favicon"
  ],
  "omnibox": {
    "keyword": "q"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quick Launcher"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "Open Quick Launcher"
    }
  }
}
