{
  "manifest_version": 3,
  "name": "Tab Counter",
  "version": "1.0.0",
  "description": "Track tab usage analytics and statistics with beautiful charts",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "sessions",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "32": "icons/icon32.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
